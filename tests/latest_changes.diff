+++ b/static/css/style.css
@@ -0,0 +1,381 @@
+:root {
+    /* Color Palette */
+    --bg-dark: #0a0a0f;
+    --bg-surface: rgba(20, 20, 30, 0.6);
+    --glass-border: rgba(255, 255, 255, 0.05);
+    
+    /* Neon Accents */
+    --accent-cyan: #00f0ff;
+    --accent-magenta: #ff003c;
+    --accent-blue: #0055ff;
+    
+    /* State Colors */
+    --state-normal: #00ff88;
+    --state-observation: #ffdd00;
+    --state-critical: #ff003c;
+    
+    /* Text */
+    --text-primary: #ffffff;
+    --text-secondary: #94a1b2;
+    --text-muted: #5a6475;
+    
+    /* Shadows & Glows */
+    --glow-cyan: 0 0 20px rgba(0, 240, 255, 0.3);
+    --glow-red: 0 0 30px rgba(255, 0, 60, 0.4);
+    --glass-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
+    
+    /* Typography */
+    --font-sans: 'Inter', sans-serif;
+    --font-display: 'Outfit', sans-serif;
+}
+
+* {
+    box-sizing: border-box;
+    margin: 0;
+    padding: 0;
+}
+
+body {
+    background-color: var(--bg-dark);
+    /* Subtle radial gradient background */
+    background-image: 
+        radial-gradient(circle at 15% 50%, rgba(0, 85, 255, 0.1) 0%, transparent 50%),
+        radial-gradient(circle at 85% 30%, rgba(255, 0, 60, 0.05) 0%, transparent 50%);
+    color: var(--text-primary);
+    font-family: var(--font-sans);
+    line-height: 1.6;
+    min-height: 100vh;
+    overflow-x: hidden;
+}
+
+/* Base Layout */
+.app-container {
+    max-width: 1400px;
+    margin: 0 auto;
+    padding: 2rem;
+    display: flex;
+    flex-direction: column;
+    gap: 2rem;
+}
+
+/* Glassmorphism Panels */
+.glass-panel {
+    background: var(--bg-surface);
+    backdrop-filter: blur(12px);
+    -webkit-backdrop-filter: blur(12px);
+    border: 1px solid var(--glass-border);
+    border-radius: 16px;
+    box-shadow: var(--glass-shadow);
+    padding: 1.5rem;
+}
+
+/* Header */
+.main-header {
+    display: flex;
+    justify-content: space-between;
+    align-items: center;
+    padding: 1.5rem 2.5rem;
+}
+
+.logo h1 {
+    font-family: var(--font-display);
+    font-weight: 800;
+    font-size: 2rem;
+    letter-spacing: -0.5px;
+    background: linear-gradient(90deg, #fff, var(--text-secondary));
+    -webkit-background-clip: text;
+    -webkit-text-fill-color: transparent;
+}
+
+.logo h1 span {
+    color: var(--accent-cyan);
+    -webkit-text-fill-color: var(--accent-cyan);
+}
+
+.status-indicator {
+    display: flex;
+    align-items: center;
+    gap: 0.5rem;
+    font-size: 0.85rem;
+    color: var(--text-secondary);
+    text-transform: uppercase;
+    letter-spacing: 1px;
+    margin-top: 0.25rem;
+}
+
+.pulse-dot {
+    width: 8px;
+    height: 8px;
+    background-color: var(--state-normal);
+    border-radius: 50%;
+    box-shadow: 0 0 10px var(--state-normal);
+    animation: pulse 2s infinite;
+}
+
+@keyframes pulse {
+    0% { transform: scale(0.95); opacity: 0.8; }
+    50% { transform: scale(1.2); opacity: 1; box-shadow: 0 0 15px var(--state-normal); }
+    100% { transform: scale(0.95); opacity: 0.8; }
+}
+
+/* State Badge */
+.system-state {
+    text-align: right;
+}
+
+.system-state .label {
+    display: block;
+    font-size: 0.75rem;
+    color: var(--text-muted);
+    text-transform: uppercase;
+    letter-spacing: 1px;
+    margin-bottom: 0.25rem;
+}
+
+.state-badge {
+    display: inline-block;
+    padding: 0.5rem 1.25rem;
+    border-radius: 50px;
+    font-family: var(--font-display);
+    font-weight: 700;
+    font-size: 1.1rem;
+    text-transform: uppercase;
+    letter-spacing: 1px;
+    transition: all 0.4s ease;
+}
+
+.state-badge.normal {
+    background: rgba(0, 255, 136, 0.1);
+    color: var(--state-normal);
+    border: 1px solid rgba(0, 255, 136, 0.3);
+}
+
+.state-badge.observation {
+    background: rgba(255, 221, 0, 0.1);
+    color: var(--state-observation);
+    border: 1px solid rgba(255, 221, 0, 0.3);
+}
+
+.state-badge.critical {
+    background: rgba(255, 0, 60, 0.15);
+    color: var(--state-critical);
+    border: 1px solid rgba(255, 0, 60, 0.5);
+    box-shadow: var(--glow-red);
+    animation: critical-pulse 1s infinite alternate;
+}
+
+@keyframes critical-pulse {
+    from { box-shadow: 0 0 10px rgba(255,0,60,0.3); }
+    to { box-shadow: 0 0 30px rgba(255,0,60,0.7); }
+}
+
+/* Dashboard Grid */
+.dashboard-grid {
+    display: grid;
+    grid-template-columns: 1fr 1fr;
+    gap: 2rem;
+}
+
+.full-width {
+    grid-column: 1 / -1;
+}
+
+.widget h2 {
+    font-family: var(--font-display);
+    font-size: 1.2rem;
+    font-weight: 600;
+    color: var(--text-primary);
+    margin-bottom: 1.5rem;
+    border-bottom: 1px solid var(--glass-border);
+    padding-bottom: 0.75rem;
+}
+
+/* Risk Gauge */
+.chart-container {
+    width: 100%;
+    height: 300px;
+}
+
+/* Context Panel */
+.context-grid {
+    display: grid;
+    grid-template-columns: 1fr 1fr;
+    gap: 1.5rem;
+    margin-bottom: 2rem;
+}
+
+.context-item {
+    background: rgba(0, 0, 0, 0.2);
+    padding: 1rem;
+    border-radius: 8px;
+    border: 1px solid var(--glass-border);
+}
+
+.context-item .label {
+    display: block;
+    font-size: 0.75rem;
+    color: var(--text-muted);
+    text-transform: uppercase;
+    letter-spacing: 1px;
+    margin-bottom: 0.5rem;
+}
+
+.context-item .value {
+    display: block;
+    font-family: var(--font-display);
+    font-weight: 600;
+    font-size: 1.1rem;
+    color: var(--text-primary);
+    word-break: break-all;
+}
+
+.ai-severity {
+    color: var(--accent-cyan) !important;
+    text-shadow: var(--glow-cyan);
+}
+
+.ai-summary-box {
+    background: linear-gradient(135deg, rgba(0,240,255,0.05) 0%, rgba(0,85,255,0.1) 100%);
+    border-left: 4px solid var(--accent-cyan);
+    padding: 1.5rem;
+    border-radius: 0 8px 8px 0;
+}
+
+.ai-summary-box h3 {
+    font-family: var(--font-display);
+    font-size: 1.1rem;
+    margin-bottom: 0.5rem;
+    color: var(--text-primary);
+}
+
+.ai-summary-box p {
+    color: var(--text-secondary);
+    font-size: 0.95rem;
+}
+
+/* Timeline */
+.timeline-list {
+    list-style: none;
+    display: flex;
+    gap: 0.5rem;
+    flex-wrap: wrap;
+}
+
+.timeline-list li {
+    background: rgba(0, 0, 0, 0.3);
+    padding: 0.5rem 1rem;
+    border-radius: 20px;
+    font-size: 0.85rem;
+    color: var(--text-secondary);
+    border: 1px solid var(--glass-border);
+    display: flex;
+    align-items: center;
+    gap: 0.5rem;
+    transition: all 0.3s ease;
+}
+
+.timeline-list li::before {
+    content: '';
+    display: inline-block;
+    width: 6px;
+    height: 6px;
+    border-radius: 50%;
+    background: var(--accent-cyan);
+}
+
+.timeline-list li:hover {
+    background: rgba(0, 240, 255, 0.1);
+    color: var(--text-primary);
+    border-color: rgba(0, 240, 255, 0.3);
+    transform: translateY(-2px);
+}
+
+.timeline-empty {
+    background: transparent !important;
+    border: none !important;
+    font-style: italic;
+    color: var(--text-muted) !important;
+}
+
+.timeline-empty::before {
+    display: none !important;
+}
+
+/* Table */
+.table-responsive {
+    overflow-x: auto;
+}
+
+.events-table {
+    width: 100%;
+    border-collapse: collapse;
+    text-align: left;
+}
+
+.events-table th {
+    font-size: 0.8rem;
+    text-transform: uppercase;
+    letter-spacing: 1px;
+    color: var(--text-muted);
+    padding: 1rem;
+    border-bottom: 1px solid var(--glass-border);
+}
+
+.events-table td {
+    padding: 1rem;
+    border-bottom: 1px solid rgba(255,255,255,0.02);
+    font-size: 0.95rem;
+    color: var(--text-secondary);
+    transition: background 0.2s ease;
+}
+
+.events-table tbody tr:hover td {
+    background: rgba(255,255,255,0.02);
+    color: var(--text-primary);
+}
+
+.events-table tbody tr:last-child td {
+    border-bottom: none;
+}
+
+.risk-pill {
+    display: inline-block;
+    padding: 0.25rem 0.75rem;
+    border-radius: 12px;
+    font-size: 0.85rem;
+    font-weight: 600;
+    background: rgba(255,255,255,0.1);
+}
+
+/* Animations for new rows */
+@keyframes rowFadeIn {
+    from { opacity: 0; transform: translateY(-10px); background: rgba(0,240,255,0.2); }
+    to { opacity: 1; transform: translateY(0); background: transparent; }
+}
+
+.new-row td {
+    animation: rowFadeIn 1s ease forwards;
+}
+
+/* Responsive */
+@media (max-width: 992px) {
+    .dashboard-grid {
+        grid-template-columns: 1fr;
+    }
+}
+
+@media (max-width: 768px) {
+    .main-header {
+        flex-direction: column;
+        gap: 1.5rem;
+        text-align: center;
+    }
+    
+    .system-state {
+        text-align: center;
+    }
+    
+    .context-grid {
+        grid-template-columns: 1fr;
+    }
+}
